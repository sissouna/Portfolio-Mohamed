---
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>CV - Mohamed</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #0b1220;
        color: white;
      }

      nav {
        background: #111827;
        padding: 30px 60px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      nav .logo {
        font-size: 28px;
        font-weight: bold;
        color: white;
        text-decoration: none;
      }

      nav .links {
        display: flex;
        gap: 35px;
      }

      nav .links a {
        color: #d1d5db;
        text-decoration: none;
        font-size: 24px;
      }

      nav .links a:hover {
        color: white;
      }

      main {
        padding: 60px;
        text-align: center;
      }

      h1 {
        font-size: 48px;
        margin-bottom: 25px;
      }

      .cv-link {
        display: inline-block;
        margin-bottom: 30px;
        padding: 14px 24px;
        background: #3b82f6;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-size: 20px;
      }

      iframe {
        width: 100%;
        max-width: 1100px;
        height: 900px;
        border: none;
        border-radius: 8px;
        background: white;
      }
    </style>
  </head>

  <body>
    <nav>
      <a class="logo" href="/Portfolio-Mohamed/">Mohamed</a>

      <div class="links">
        <a href="/Portfolio-Mohamed/">Accueil</a>
        <a href="/Portfolio-Mohamed/projects">Projets</a>
        <a href="/Portfolio-Mohamed/about">À propos</a>
        <a href="/Portfolio-Mohamed/contact">Contact</a>
        <a href="/Portfolio-Mohamed/cv">CV</a>
      </div>
    </nav>

    <main>
      <h1>Mon CV</h1>

      <a class="cv-link" href="/Portfolio-Mohamed/cv-mohamed.pdf" target="_blank">
        Ouvrir le CV dans un nouvel onglet
      </a>

      <iframe
        src="/Portfolio-Mohamed/cv-mohamed.pdf"
        title="CV de Mohamed"
      ></iframe>
    </main>
  </body>
</html>