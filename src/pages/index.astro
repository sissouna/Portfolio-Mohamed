<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>Portfolio - Mohamed</title>
  </head>

  <body>

    <!-- NAVIGATION -->
    <nav class="nav">
      <div class="logo">Mohamed</div>

      <div class="links">
        <a href="/">Accueil</a>
        <a href="/projects">Projets</a>
        <a href="/about">À propos</a>
        <a href="/contact">Contact</a>
      </div>
    </nav>

    <!-- HERO -->
    <main class="hero">
      <h1>Bonjour 👋</h1>
      <p>Bonjour, je suis Mohamed, Actuellement étudiant en BTS SIO option SLAM</p>

      <div class="buttons">
        <a class="btn primary" href="/projects">Voir mes projets</a>
        <a class="btn" href="/contact">Me contacter</a>
      </div>
    </main>

  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: #0b1220;
    color: white;
  }

  /* NAV */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    background: #0f172a;
    position: sticky;
    top: 0;
  }

  .logo {
    font-weight: bold;
    font-size: 18px;
  }

  .links a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    opacity: 0.8;
    transition: 0.2s;
  }

  .links a:hover {
    opacity: 1;
    color: #60a5fa;
  }

  /* HERO */
  .hero {
    text-align: center;
    padding: 120px 20px;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 10px;
  }

  .hero p {
    opacity: 0.7;
    font-size: 1.2rem;
    margin-bottom: 30px;
  }

  /* BUTTONS */
  .buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
  }

  .btn {
    padding: 12px 20px;
    border-radius: 10px;
    text-decoration: none;
    color: white;
    border: 1px solid #334155;
    transition: 0.2s;
  }

  .btn:hover {
    transform: scale(1.05);
  }

  .primary {
    background: #3b82f6;
    border: none;
  }

  .primary:hover {
    background: #2563eb;
  }
</style>